# API Gateway URL for your environment. Keep secrets out of NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
# Catalog and auction listing/detail use Gateway APIs. Legacy mock source switches
# are disabled in app.config.ts; old mock code remains for tests/unfinished admin actions.
# NEXT_PUBLIC_CATALOG_SOURCE=mock
# NEXT_PUBLIC_AUCTION_SOURCE=mock
