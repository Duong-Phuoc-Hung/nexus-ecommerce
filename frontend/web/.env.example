# API Gateway URL for your environment. Keep secrets out of NEXT_PUBLIC variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=10000
# Customer catalog source: mock or api. Admin product pages use Gateway APIs.
NEXT_PUBLIC_CATALOG_SOURCE=api

# Development auction UI: mock enables local workflows; api keeps Admin read-only Gateway list.
# Mock mutations are disabled in production. Does not bypass authentication.
NEXT_PUBLIC_AUCTION_SOURCE=api
