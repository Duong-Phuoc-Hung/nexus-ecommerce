# ==============================================================================
# AUCTION SERVICE - LOCAL ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
PORT=4004
AUCTION_SERVICE_PORT=4004
NODE_ENV=development

# Database Connection (PostgreSQL 16 - Port 5435)
DATABASE_URL=postgresql://nexus_auction:nexus_password@localhost:5435/nexus_auction_db

# Redis Connection (Cache, Session & Distributed Locks - Redlock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=5000
REDIS_PING_TIMEOUT_MS=1500
REDIS_URL=redis://localhost:6379

# RabbitMQ Event Broker (AMQP Port 5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
