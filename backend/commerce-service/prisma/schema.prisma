// =============================================================================
// Project Nexus - Commerce Service Prisma Schema (SRS 3.4)
// Database: PostgreSQL (nexus_commerce_db - Port 5434)
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/infrastructure/database/generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. BẢNG GIỎ HÀNG (Hạn lưu 7 ngày theo SRS 3.4.1)
// -----------------------------------------------------------------------------
model Cart {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id        BigInt     @id @default(autoincrement())

  // Tham chiếu người dùng nếu đã đăng nhập (Lấy 'id' từ user_users bên user-service - UUID, NULL nếu là khách)
  userId    String?    @map("user_id") @db.VarChar(36)

  // Mã định danh phiên duyệt web của khách vãng lai (Dùng để gộp giỏ hàng khi họ đăng nhập)
  sessionId String?    @map("session_id") @db.VarChar(100)

  // Thời điểm giỏ hàng tự động hết hạn (SRS: Mặc định sau 7 ngày không hoạt động)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz()

  // Thời gian tạo và cập nhật giỏ hàng
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  items     CartItem[]

  @@index([userId], map: "idx_cart_user")
  @@index([sessionId], map: "idx_cart_session")
  @@map("commerce_carts")
}

// -----------------------------------------------------------------------------
// 2. BẢNG MÓN HÀNG TRONG GIỎ (Lưu danh sách món hàng khách chọn mua)
// -----------------------------------------------------------------------------
model CartItem {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id        BigInt   @id @default(autoincrement())

  // Thuộc giỏ hàng nào (Khóa ngoại nối với commerce_carts)
  cartId    BigInt   @map("cart_id")

  // Tham chiếu sản phẩm được chọn (Lấy 'id' từ catalog_products bên catalog-service - UUIDv7)
  productId String   @map("product_id") @db.VarChar(36)

  // Số lượng món hàng khách chọn mua (Tối thiểu 1)
  quantity  Int      @default(1)

  // Giá của sản phẩm tại thời điểm bấm thêm vào giỏ
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)

  // Thời gian thêm và cập nhật món hàng
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId], map: "idx_cart_item_cart")
  @@index([productId], map: "idx_cart_item_product")
  @@map("commerce_cart_items")
}

// -----------------------------------------------------------------------------
// 3. BẢNG ĐƠN ĐẶT HÀNG (Phiên thanh toán 15 phút theo SRS 3.4.1)
// -----------------------------------------------------------------------------
model Order {
  // Khóa chính: Chuẩn hóa UUIDv7 RFC 9562 (VARCHAR 36)
  id                       String      @id @default(uuid()) @map("id") @db.VarChar(36)

  // Mã đơn hàng hiển thị cho khách xem (VD: "ORD-20261008-001")
  orderCode                String      @unique @map("order_code") @db.VarChar(50)

  // Tham chiếu người mua (Lấy 'id' từ user_users bên user-service - UUID)
  buyerId                  String      @map("buyer_id") @db.VarChar(36)

  // Tham chiếu người bán (Lấy 'id' từ user_users bên user-service - UUID)
  sellerId                 String      @map("seller_id") @db.VarChar(36)

  // Thông tin người mua và người bán hỗ trợ tra cứu
  buyerName                String?     @map("buyer_name") @db.VarChar(100)
  buyerEmail               String?     @map("buyer_email") @db.VarChar(100)
  sellerName               String?     @map("seller_name") @db.VarChar(100)

  // Tổng số tiền khách phải thanh toán (Tiền hàng + ship - giảm giá)
  totalAmount              Decimal     @map("total_amount") @db.Decimal(12, 2)

  // Tiền phí vận chuyển đơn hàng
  shippingFee              Decimal     @default(0.00) @map("shipping_fee") @db.Decimal(12, 2)

  // Tiền giảm giá / Voucher khuyến mãi
  discountAmount           Decimal     @default(0.00) @map("discount_amount") @db.Decimal(12, 2)

  // Thông tin mã giảm giá và đơn vị vận chuyển snapshot (SRS B06 / B08 / B14)
  promoCode                String?     @map("promo_code") @db.VarChar(50)
  taxAmount                Decimal     @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  shippingCarrier          String?     @map("shipping_carrier") @db.VarChar(50)
  shippingServiceName      String?     @map("shipping_service_name") @db.VarChar(100)
  estimatedDeliveryAt      DateTime?   @map("estimated_delivery_at") @db.Timestamptz()

  // Trạng thái ký quỹ Escrow: PENDING, HELD, RELEASED, REFUNDED (SRS 3.4)
  escrowStatus             String?     @default("PENDING") @map("escrow_status") @db.VarChar(20)
  escrowAmount             Decimal?    @default(0.00) @map("escrow_amount") @db.Decimal(12, 2)
  escrowReleasedAt         DateTime?   @map("escrow_released_at") @db.Timestamptz()

  // Trạng thái đơn: PENDING_PAYMENT, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  status                   String      @default("PENDING_PAYMENT") @db.VarChar(30)

  // Địa chỉ nhận hàng đầy đủ (Lưu JSON: Họ tên, SĐT, Tỉnh/Thành, Địa chỉ chi tiết)
  shippingAddress          Json        @map("shipping_address")

  // Hạn chót 15 phút để hoàn tất thanh toán (SRS: Quá 15 phút tự động hủy đơn)
  checkoutSessionExpiresAt DateTime?   @map("checkout_session_expires_at") @db.Timestamptz()

  // Mã vận đơn và dòng thời gian xử lý đơn hàng
  trackingCode             String?     @map("tracking_code") @db.VarChar(100)
  timeline                 Json?       @default("[]") @map("timeline")

  // Thời gian tạo và cập nhật đơn hàng
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  items                    OrderItem[]
  payments                 Payment[]
  invoices                 Invoice[]
  reservations             StockReservation[]
  promotionUsages          PromotionUsage[]

  @@index([buyerId], map: "idx_order_buyer")
  @@index([sellerId], map: "idx_order_seller")
  @@index([status], map: "idx_order_status")
  @@index([orderCode], map: "idx_order_code")
  @@map("commerce_orders")
}

// -----------------------------------------------------------------------------
// 4. BẢNG CHI TIẾT MÓN HÀNG TRONG ĐƠN (Chụp lại Snapshot giá và tên tại lúc mua)
// -----------------------------------------------------------------------------
model OrderItem {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id           BigInt   @id @default(autoincrement())

  // Thuộc đơn hàng nào (Khóa ngoại nối với commerce_orders - UUIDv7 VARCHAR 36)
  orderId      String   @map("order_id") @db.VarChar(36)

  // Tham chiếu sản phẩm (Lấy 'id' từ catalog_products bên catalog-service - UUIDv7)
  productId    String   @map("product_id") @db.VarChar(36)

  // Tên sản phẩm tại thời điểm mua (Snapshot chống seller đổi tên sau đó)
  productTitle String   @map("product_title") @db.VarChar(255)

  // Đơn giá tại thời điểm chốt đơn (Snapshot chống seller tăng/giảm giá sau đó)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)

  // Số lượng mua
  quantity     Int      @default(1)

  // Thành tiền của món hàng (= unitPrice * quantity)
  subtotal     Decimal  @db.Decimal(12, 2)

  // Thời gian tạo bản ghi
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_item_order")
  @@index([productId], map: "idx_order_item_product")
  @@map("commerce_order_items")
}

// -----------------------------------------------------------------------------
// 5. BẢNG GIAO DỊCH THANH TOÁN (Khóa chống trừ tiền lặp lại 60 phút - SRS 3.4.2)
// -----------------------------------------------------------------------------
model Payment {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id             BigInt   @id @default(autoincrement())

  // Thuộc đơn hàng nào (Khóa ngoại nối với commerce_orders - UUIDv7 VARCHAR 36)
  orderId        String   @map("order_id") @db.VarChar(36)

  // Phương thức thanh toán: STRIPE, COD, VNPAY, MOMO
  paymentMethod  String   @default("STRIPE") @map("payment_method") @db.VarChar(30)

  // Mã giao dịch thanh toán từ Stripe (VD: "pi_3MtwBwLkdIwHu7ix28a3tqPa")
  transactionId  String?  @map("transaction_id") @db.VarChar(100)

  // Khóa Idempotency chống gọi Webhook trừ tiền 2 lần trong 60 phút
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(100)

  // Số tiền thực thanh toán
  amount         Decimal  @db.Decimal(12, 2)

  // Đơn vị tiền tệ (VND, USD)
  currency       String   @default("VND") @db.VarChar(10)

  // Trạng thái thanh toán: PENDING, SUCCEEDED, FAILED, REFUNDED
  status         String   @default("PENDING") @db.VarChar(20)

  // Dữ liệu gốc JSON trả về từ cổng thanh toán Stripe để lưu vết kiểm toán
  rawResponse    Json?    @map("raw_response")

  // Hỗ trợ cổng thanh toán PayOS (V2)
  payosOrderCode BigInt?  @unique @map("payos_order_code")
  paymentLinkId  String?  @map("payment_link_id") @db.VarChar(100)
  checkoutUrl    String?  @map("checkout_url") @db.Text
  qrCode         String?  @map("qr_code") @db.Text
  bankBin        String?  @map("bank_bin") @db.VarChar(20)
  accountNumber  String?  @map("account_number") @db.VarChar(100)
  accountName    String?  @map("account_name") @db.VarChar(255)
  transferDescription String? @map("transfer_description") @db.Text
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz()
  paidAt         DateTime? @map("paid_at") @db.Timestamptz()

  // Thời gian tạo và cập nhật giao dịch
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_payment_order")
  @@index([status], map: "idx_payment_status")
  @@map("commerce_payments")
}

// -----------------------------------------------------------------------------
// 6. BẢNG HÓA ĐƠN / BIÊN LAI ĐIỆN TỬ (Xuất cho khách sau khi đơn hoàn tất)
// -----------------------------------------------------------------------------
model Invoice {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id          BigInt   @id @default(autoincrement())

  // Thuộc đơn hàng nào (Khóa ngoại nối với commerce_orders - UUIDv7 VARCHAR 36)
  orderId     String   @map("order_id") @db.VarChar(36)

  // Mã số hóa đơn điện tử (VD: "INV-20261008-001")
  invoiceCode String   @unique @map("invoice_code") @db.VarChar(50)

  // Đường dẫn tải file PDF hóa đơn trên Cloud Storage
  pdfUrl      String?  @map("pdf_url") @db.VarChar(500)

  // Thời điểm xuất hóa đơn
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz()

  // Thời gian tạo bản ghi
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_invoice_order")
  @@map("commerce_invoices")
}

// -----------------------------------------------------------------------------
// 7. BẢNG BÁO GIÁ CHECKOUT (Hiệu lực 15 phút theo V2)
// -----------------------------------------------------------------------------
model CheckoutQuote {
  id              String   @id @db.VarChar(36)
  buyerId         String   @map("buyer_id") @db.VarChar(36)
  sellerId        String   @map("seller_id") @db.VarChar(36)
  items           Json
  shippingAddress Json     @map("shipping_address")
  subtotal        Decimal  @db.Decimal(12, 2)
  shippingFee     Decimal  @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal  @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  promoCode       String?  @map("promo_code") @db.VarChar(50)
  shippingOptionId String? @map("shipping_option_id") @db.VarChar(50)
  metadata        Json?    @default("{}") @map("metadata")
  currency        String   @default("VND") @db.VarChar(10)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([buyerId], map: "idx_quote_buyer")
  @@map("commerce_checkout_quotes")
}

// -----------------------------------------------------------------------------
// 8. BẢNG KHÓA IDEMPOTENCY CHECKOUT (Chống duplicate submission theo V2)
// -----------------------------------------------------------------------------
model CheckoutIdempotency {
  buyerId        String   @map("buyer_id") @db.VarChar(36)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  orderId        String?  @map("order_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([buyerId, idempotencyKey])
  @@map("commerce_checkout_idempotency")
}

// -----------------------------------------------------------------------------
// 9. BẢNG GIỮ HÀNG TỒN KHO TẠM THỜI (ACTIVE | COMMITTED | RELEASED theo V2)
// -----------------------------------------------------------------------------
model StockReservation {
  id        BigInt   @id @default(autoincrement())
  orderId   String   @map("order_id") @db.VarChar(36)
  productId String   @map("product_id") @db.VarChar(36)
  quantity  Int
  status    String   @default("ACTIVE") @db.VarChar(12)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId, status, expiresAt], map: "idx_reservation_product")
  @@index([orderId], map: "idx_reservation_order")
  @@map("commerce_stock_reservations")
}

// -----------------------------------------------------------------------------
// 10. BẢNG MÃ KHUYẾN MÃI / VOUCHER (SRS B14)
// -----------------------------------------------------------------------------
model Promotion {
  id                String           @id @default(uuid()) @map("id") @db.VarChar(36)
  code              String           @unique @map("code") @db.VarChar(50)
  name              String           @map("name") @db.VarChar(255)
  description       String?          @map("description") @db.Text
  discountType      String           @default("FIXED") @map("discount_type") @db.VarChar(20)
  discountValue     Decimal          @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?         @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal          @default(0.00) @map("min_order_amount") @db.Decimal(12, 2)
  usageLimit        Int              @default(1000) @map("usage_limit")
  usedCount         Int              @default(0) @map("used_count")
  perUserLimit      Int              @default(1) @map("per_user_limit")
  scope             String           @default("ALL_USERS") @map("scope") @db.VarChar(24)
  categoryIds       Json             @default("[]") @map("category_ids")
  startsAt          DateTime         @default(now()) @map("starts_at") @db.Timestamptz()
  endsAt            DateTime         @map("ends_at") @db.Timestamptz()
  status            String           @default("ACTIVE") @map("status") @db.VarChar(20)
  createdBy         String?          @map("created_by") @db.VarChar(64)
  updatedBy         String?          @map("updated_by") @db.VarChar(64)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  usages            PromotionUsage[]

  @@index([code], map: "idx_promo_code")
  @@index([status, startsAt, endsAt], map: "idx_promo_status_dates")
  @@index([scope], map: "idx_promo_scope")
  @@map("commerce_promotions")
}

// -----------------------------------------------------------------------------
// 11. BẢNG LỊCH SỬ DÙNG MÃ KHUYẾN MÃI (SRS B14)
// -----------------------------------------------------------------------------
model PromotionUsage {
  id             BigInt    @id @default(autoincrement())
  promotionId    String    @map("promotion_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  orderId        String?   @map("order_id") @db.VarChar(36)
  discountAmount Decimal   @map("discount_amount") @db.Decimal(12, 2)
  usedAt         DateTime  @default(now()) @map("used_at") @db.Timestamptz()

  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([promotionId, userId], map: "idx_promo_usage_promo_user")
  @@index([orderId], map: "idx_promo_usage_order")
  @@map("commerce_promotion_usages")
}
