// =============================================================================
// Project Nexus - User Service Prisma Schema (SRS 3.1 & 2.7)
// Database: PostgreSQL (nexus_user_db - Port 5432)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. ROLES & PRIVILEGES (RBAC - Phân quyền theo 65 mã quyền hệ thống)
// -----------------------------------------------------------------------------

model Role {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id          BigInt          @id @default(autoincrement())

  // Mã vai trò duy nhất: ADMIN, SELLER, BUYER, SUPPORT
  roleCode    String          @unique @map("role_code") @db.VarChar(50)

  // Tên hiển thị của vai trò (VD: "Quản trị viên", "Người bán", "Người mua")
  roleName    String          @map("role_name") @db.VarChar(100)

  // Mô tả nhiệm vụ của vai trò
  description String?         @db.VarChar(255)

  // Thời gian tạo và cập nhật vai trò
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  privileges  RolePrivilege[]
  userRoles   UserRole[]

  @@index([roleName], map: "idx_role_name")
  @@map("user_roles")
}

model Privilege {
  // Khóa chính: Số tự tăng (1, 2, 3...)
  id          BigInt          @id @default(autoincrement())

  // Mã định danh quyền (Thuộc 65 mã quyền trong SRS 2.7, VD: "USER_VIEW", "PRODUCT_CREATE")
  code        String          @unique @db.VarChar(100)

  // Diễn giải ý nghĩa của quyền hạn
  description String          @db.VarChar(255)

  // Thời gian tạo quyền
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  roles       RolePrivilege[]

  @@map("user_privileges")
}

model RolePrivilege {
  // Nối vai trò nào với quyền hạn nào (Bảng trung gian N-N)
  roleId      BigInt    @map("role_id")
  privilegeId BigInt    @map("privilege_id")

  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@id([roleId, privilegeId])
  @@map("user_role_privileges")
}

// -----------------------------------------------------------------------------
// 2. USER ACCOUNTS & AUTHENTICATION (Quản lý hồ sơ & Đăng nhập)
// -----------------------------------------------------------------------------

model User {
  // Khóa chính: Số tự tăng (1, 2, 3...) - Dùng làm ID người dùng duy nhất toàn hệ thống
  id             BigInt               @id @default(autoincrement())

  // Email đăng nhập duy nhất
  email          String               @unique @db.VarChar(100)

  // Số điện thoại liên hệ duy nhất
  phone          String               @unique @db.VarChar(20)

  // Mật khẩu đã được mã hóa băm bằng bcrypt/argon2
  passwordHash   String               @map("password_hash") @db.VarChar(255)

  // Họ và tên đầy đủ
  fullName       String               @map("full_name") @db.VarChar(100)

  // Số Căn cước công dân / CMND (Phục vụ định danh tài khoản người bán)
  identifyNumber String               @map("identify_number") @db.VarChar(20)

  // Giới tính (MALE, FEMALE, OTHER)
  gender         String?              @db.VarChar(10)

  // Ngày tháng năm sinh
  dateOfBirth    DateTime?            @map("date_of_birth") @db.Date

  // Địa chỉ cư trú mặc định
  address        String?              @db.VarChar(255)

  // Trạng thái tài khoản: ACTIVE (Bình thường), LOCKED (Khóa tạm), SUSPENDED (Cấm vĩnh viễn)
  status         String               @default("ACTIVE") @db.VarChar(20)

  // Cờ đánh dấu xóa mềm (TRUE: Đã xóa tài khoản, FALSE: Đang hoạt động)
  isDeleted      Boolean              @default(false) @map("is_deleted")

  // Thời gian tạo và cập nhật tài khoản
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  roles          UserRole[]
  resetTokens    PasswordResetToken[]
  reputation     Reputation?

  @@index([fullName], map: "idx_user_full_name")
  @@index([status], map: "idx_user_status")
  @@map("user_users")
}

model UserRole {
  // Gán tài khoản người dùng với vai trò tương ứng (ADMIN, SELLER, BUYER)
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_user_roles")
}

model PasswordResetToken {
  // Khóa chính
  id        BigInt   @id @default(autoincrement())

  // Tài khoản yêu cầu quên mật khẩu
  userId    BigInt   @map("user_id")

  // Mã token bảo mật đã được băm gửi qua email
  tokenHash String   @map("token_hash") @db.VarChar(255)

  // Thời điểm token hết hạn (Thường là 15-30 phút)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  // Đã sử dụng mã token này chưa (Tránh dùng lại)
  used      Boolean  @default(false)

  // Thời gian tạo token
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_token_user_expires")
  @@map("user_password_reset_tokens")
}

// -----------------------------------------------------------------------------
// 3. REPUTATION & RATINGS & PENALTIES (SRS 3.1.2 - Điểm uy tín, Đánh giá, Xử phạt)
// -----------------------------------------------------------------------------

model Reputation {
  // Khóa chính
  id             BigInt   @id @default(autoincrement())

  // Nối 1-1 với tài khoản người dùng
  userId         BigInt   @unique @map("user_id")

  // Cấp bậc uy tín: NEWBORN (Mới), STANDARD (Chuẩn), TRUSTED (Uy tín), VIP, SUSPENDED
  trustLevel     String   @default("NEWBORN") @map("trust_level") @db.VarChar(20)

  // Điểm số uy tín (Mặc định 100 điểm, bị trừ nếu vi phạm, cộng khi hoàn thành đơn tốt)
  score          Int      @default(100)

  // Tổng số đơn hàng đã hoàn thành thành công
  totalOrders    Int      @default(0) @map("total_orders")

  // Tổng số lần bị phạt vi phạm
  totalPenalties Int      @default(0) @map("total_penalties")

  // Thời gian cập nhật điểm uy tín
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_reputations")
}

model Rating {
  // Khóa chính
  id         BigInt   @id @default(autoincrement())

  // Mã đơn hàng liên quan (Lấy từ commerce_orders)
  orderId    String   @map("order_id") @db.VarChar(64)

  // Người thực hiện đánh giá (Người mua)
  fromUserId BigInt   @map("from_user_id")

  // Người nhận đánh giá (Người bán)
  toUserId   BigInt   @map("to_user_id")

  // Số sao đánh giá (Từ 1 đến 5 sao)
  rating     Int      @db.SmallInt

  // Nhận xét chi tiết về chất lượng sản phẩm / dịch vụ
  comment    String?  @db.Text

  // Thời gian đánh giá
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([orderId, fromUserId, toUserId], map: "uq_order_rating_pair")
  @@index([toUserId], map: "idx_rating_to_user")
  @@map("user_ratings")
}

model Penalty {
  // Khóa chính
  id          BigInt   @id @default(autoincrement())

  // Người dùng bị phạt (Lấy 'id' từ user_users)
  userId      BigInt   @map("user_id")

  // Lý do bị phạt (VD: "Quá hạn 24h không thanh toán phiên đấu giá", "Hủy đơn không lý do")
  reason      String   @db.VarChar(255)

  // Số điểm uy tín bị trừ (SRS: Mặc định trừ 10 điểm)
  deductScore Int      @default(10) @map("deduct_score")

  // Thời điểm ghi nhận quyết định xử phạt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId], map: "idx_penalty_user")
  @@map("user_penalties")
}

// -----------------------------------------------------------------------------
// 4. AUDIT LOGS (SRS 3.1.1 - Nhật ký kiểm toán bảo mật tài khoản)
// -----------------------------------------------------------------------------

model AuditLog {
  // Khóa chính
  id             BigInt   @id @default(autoincrement())

  // Ai là người thực hiện hành động (NULL nếu là hệ thống tự động)
  actorId        BigInt?  @map("actor_id")

  // Hành động: LOGIN, LOGOUT, CHANGE_PASSWORD, LOCK_USER, UPDATE_PROFILE
  action         String   @db.VarChar(50)

  // Đối tượng bị tác động (USER, ROLE, PRIVILEGE)
  targetResource String   @map("target_resource") @db.VarChar(50)

  // ID của đối tượng bị tác động
  targetId       String   @map("target_id") @db.VarChar(64)

  // Chi tiết bổ sung (IP address, User-Agent, lý do khóa...)
  details        String?  @db.Text

  // Thời điểm ghi nhận log
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([actorId], map: "idx_audit_actor")
  @@index([targetResource, targetId], map: "idx_audit_target")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created_at")
  @@map("user_audit_logs")
}
