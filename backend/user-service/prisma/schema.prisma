// =============================================================================
// Project Nexus - User Service Prisma Schema (SRS 3.1 & 2.7)
// Database: PostgreSQL (nexus_user_db - Port 5432)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. ROLES & PRIVILEGES (RBAC)
// -----------------------------------------------------------------------------

model Role {
  id          BigInt          @id @default(autoincrement())
  roleCode    String          @unique @map("role_code") @db.VarChar(50)
  roleName    String          @map("role_name") @db.VarChar(100)
  description String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  privileges  RolePrivilege[]
  userRoles   UserRole[]

  @@index([roleName], map: "idx_role_name")
  @@map("user_roles")
}

model Privilege {
  id          BigInt          @id @default(autoincrement())
  code        String          @unique @db.VarChar(100)
  description String          @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  roles       RolePrivilege[]

  @@map("user_privileges")
}

model RolePrivilege {
  roleId      BigInt    @map("role_id")
  privilegeId BigInt    @map("privilege_id")

  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@id([roleId, privilegeId])
  @@map("user_role_privileges")
}

// -----------------------------------------------------------------------------
// 2. USER ACCOUNTS & AUTHENTICATION
// -----------------------------------------------------------------------------

model User {
  id             BigInt               @id @default(autoincrement())
  email          String               @unique @db.VarChar(100)
  phone          String               @unique @db.VarChar(20)
  passwordHash   String               @map("password_hash") @db.VarChar(255)
  fullName       String               @map("full_name") @db.VarChar(100)
  identifyNumber String               @map("identify_number") @db.VarChar(20)
  gender         String?              @db.VarChar(10)
  dateOfBirth    DateTime?            @map("date_of_birth") @db.Date
  address        String?              @db.VarChar(255)
  status         String               @default("ACTIVE") @db.VarChar(20) // ACTIVE, LOCKED, SUSPENDED
  isDeleted      Boolean              @default(false) @map("is_deleted")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  roles          UserRole[]
  resetTokens    PasswordResetToken[]
  reputation     Reputation?

  @@index([fullName], map: "idx_user_full_name")
  @@index([status], map: "idx_user_status")
  @@map("user_users")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_user_roles")
}

model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_token_user_expires")
  @@map("user_password_reset_tokens")
}

// -----------------------------------------------------------------------------
// 3. REPUTATION & RATINGS & PENALTIES (SRS 3.1.2)
// -----------------------------------------------------------------------------

model Reputation {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @unique @map("user_id")
  trustLevel     String   @default("NEWBORN") @map("trust_level") @db.VarChar(20) // NEWBORN, STANDARD, TRUSTED, VIP, SUSPENDED
  score          Int      @default(100)
  totalOrders    Int      @default(0) @map("total_orders")
  totalPenalties Int      @default(0) @map("total_penalties")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_reputations")
}

model Rating {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id") @db.VarChar(64)
  fromUserId BigInt   @map("from_user_id")
  toUserId   BigInt   @map("to_user_id")
  rating     Int      @db.SmallInt // 1 to 5
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([orderId, fromUserId, toUserId], map: "uq_order_rating_pair")
  @@index([toUserId], map: "idx_rating_to_user")
  @@map("user_ratings")
}

model Penalty {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  reason      String   @db.VarChar(255)
  deductScore Int      @default(10) @map("deduct_score")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId], map: "idx_penalty_user")
  @@map("user_penalties")
}

// -----------------------------------------------------------------------------
// 4. AUDIT LOGS (SRS 3.1.1)
// -----------------------------------------------------------------------------

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  actorId        BigInt?  @map("actor_id")
  action         String   @db.VarChar(50)
  targetResource String   @map("target_resource") @db.VarChar(50)
  targetId       String   @map("target_id") @db.VarChar(64)
  details        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([actorId], map: "idx_audit_actor")
  @@index([targetResource, targetId], map: "idx_audit_target")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created_at")
  @@map("user_audit_logs")
}
