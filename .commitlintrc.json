{
  "$schema": "https://json.schemastore.org/commitlintrc.json",
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "root",
        "devops",
        "infra",
        "docker",
        "shared",
        "contracts",
        "utils",
        "user",
        "auth",
        "iam",
        "reputation",
        "catalog",
        "search",
        "fulfillment",
        "inventory",
        "shipping",
        "commerce",
        "cart",
        "checkout",
        "order",
        "payment",
        "stripe",
        "auction",
        "bidding",
        "settlement",
        "notification",
        "logs",
        "gateway",
        "web",
        "admin",
        "customer",
        "web-customer",
        "web-admin",
        "scripts",
        "deps",
        "config",
        "ci"
      ]
    ],
    "scope-case": [2, "always", "lower-case"],
    "subject-case": [0],
    "subject-empty": [2, "never"],
    "subject-full-stop": [2, "never", "."]
  }
}
