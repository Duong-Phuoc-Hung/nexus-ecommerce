# ==============================================================================
# PROJECT NEXUS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your local development environment.
# ==============================================================================

# Node Environment
NODE_ENV=development
TZ=UTC

# ==============================================================================
# API GATEWAY & MICROSERVICES HTTP PORTS
# ==============================================================================
GATEWAY_PORT=8000
USER_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
COMMERCE_SERVICE_PORT=3003
AUCTION_SERVICE_PORT=3004
FULFILLMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006

# Frontend Ports
WEB_CLIENT_PORT=3000
ADMIN_PORTAL_PORT=3010

# ==============================================================================
# DATABASE CONNECTIONS (PostgreSQL 16 - Isolated per Service)
# Matching devops/docker-compose.dev.yml
# ==============================================================================
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=nexus_user_db
USER_DB_USER=nexus_user
USER_DB_PASSWORD=nexus_password
USER_DB_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_user_db

CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5433
CATALOG_DB_NAME=nexus_catalog_db
CATALOG_DB_USER=nexus_catalog
CATALOG_DB_PASSWORD=nexus_password
CATALOG_DB_URL=postgresql://nexus_catalog:nexus_password@localhost:5433/nexus_catalog_db

COMMERCE_DB_HOST=localhost
COMMERCE_DB_PORT=5434
COMMERCE_DB_NAME=nexus_commerce_db
COMMERCE_DB_USER=nexus_commerce
COMMERCE_DB_PASSWORD=nexus_password
COMMERCE_DB_URL=postgresql://nexus_commerce:nexus_password@localhost:5434/nexus_commerce_db

AUCTION_DB_HOST=localhost
AUCTION_DB_PORT=5435
AUCTION_DB_NAME=nexus_auction_db
AUCTION_DB_USER=nexus_auction
AUCTION_DB_PASSWORD=nexus_password
AUCTION_DB_URL=postgresql://nexus_auction:nexus_password@localhost:5435/nexus_auction_db

FULFILLMENT_DB_HOST=localhost
FULFILLMENT_DB_PORT=5436
FULFILLMENT_DB_NAME=nexus_fulfillment_db
FULFILLMENT_DB_USER=nexus_fulfillment
FULFILLMENT_DB_PASSWORD=nexus_password
FULFILLMENT_DB_URL=postgresql://nexus_fulfillment:nexus_password@localhost:5436/nexus_fulfillment_db

NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5437
NOTIFICATION_DB_NAME=nexus_notification_db
NOTIFICATION_DB_USER=nexus_notification
NOTIFICATION_DB_PASSWORD=nexus_password
NOTIFICATION_DB_URL=postgresql://nexus_notification:nexus_password@localhost:5437/nexus_notification_db

# ==============================================================================
# REDIS (Cache, Session & Distributed Locks - Redlock)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=5000
REDIS_URL=redis://localhost:6379

# ==============================================================================
# RABBITMQ (Message Broker - AMQP & Management UI)
# ==============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================================================
# SECURITY & AUTHENTICATION (SRS 3.1 & 4.1)
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_BCRYPT_ROUNDS=12

# ==============================================================================
# THIRD-PARTY INTEGRATIONS
# ==============================================================================
# Stripe Payment Gateway (SRS 3.4 Commerce Service)
STRIPE_SECRET_KEY=sk_test_replace_with_actual_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_actual_stripe_webhook_secret
STRIPE_CURRENCY=usd

# Cloudinary / Image Storage (Catalog & KYC document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP / Email Service (SRS 3.2 Notification Service)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM_EMAIL=no-reply@nexus-ecommerce.com
SMTP_FROM_NAME="Nexus E-Commerce Platform"
