{
  "name": "nexus-ecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Project Nexus - Microservices E-Commerce & Real-Time Auction Platform Monorepo",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "npm --prefix frontend/web-customer run dev",
    "prepare": "husky",
    "check:branch": "node scripts/verify-branch-name.js",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,yml,yaml}\"",
    "test": "node --test scripts/test-infrastructure.test.js scripts/test-architecture-boundaries.test.js scripts/test-redis-configuration.test.js scripts/test-redis-key-prefix.test.js scripts/test-domain-event-and-publisher.test.js scripts/test-inter-module-event-flow.test.js",
    "test:arch": "node --test scripts/test-architecture-boundaries.test.js",
    "test:infra": "node --test scripts/test-infrastructure.test.js",
    "test:redis": "node --test scripts/test-redis-configuration.test.js",
    "test:redis:prefix": "node --test scripts/test-redis-key-prefix.test.js",
    "test:events": "node --test scripts/test-domain-event-and-publisher.test.js scripts/test-inter-module-event-flow.test.js",
    "qa:redis": "node scripts/qa-verify-redis.js",
    "db:migrate": "node scripts/migrate-all-databases.js",
    "db:reset": "pnpm docker:dev:clean && pnpm docker:dev:up && pnpm db:migrate",
    "build:contracts": "pnpm --filter @nexus/contracts build",
    "build": "pnpm --filter @nexus/contracts build && pnpm -r --filter \"./backend/*\" build",
    "dev:gateway": "pnpm --filter @nexus/api-gateway dev",
    "dev:user": "pnpm --filter @nexus/user-service dev",
    "dev:catalog": "pnpm --filter @nexus/catalog-service dev",
    "dev:commerce": "pnpm --filter @nexus/commerce-service dev",
    "dev:auction": "pnpm --filter @nexus/auction-service dev",
    "dev:fulfillment": "pnpm --filter @nexus/fulfillment-service dev",
    "dev:notification": "pnpm --filter @nexus/notification-service dev",
    "dev:all": "pnpm --parallel --filter \"./backend/*\" --filter @nexus/web-customer dev",
    "dev:auth": "pnpm --parallel --filter @nexus/api-gateway --filter @nexus/user-service --filter @nexus/web-customer dev",
    "dev:auction": "pnpm --parallel --filter @nexus/api-gateway --filter @nexus/auction-service --filter @nexus/web-customer dev",
    "dev:shop": "pnpm --parallel --filter @nexus/api-gateway --filter @nexus/catalog-service --filter @nexus/commerce-service --filter @nexus/web-customer dev",
    "docker:dev:up": "docker compose -f devops/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f devops/docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f devops/docker-compose.dev.yml logs -f",
    "docker:dev:ps": "docker compose -f devops/docker-compose.dev.yml ps",
    "docker:dev:restart": "docker compose -f devops/docker-compose.dev.yml restart",
    "docker:dev:clean": "docker compose -f devops/docker-compose.dev.yml down -v",
    "docker:build": "node scripts/build-all-images.js",
    "docker:build:sh": "bash scripts/build-all-images.sh",
    "docker:full:up": "docker compose -f devops/docker-compose.full.yml up -d",
    "docker:full:down": "docker compose -f devops/docker-compose.full.yml down",
    "docker:full:logs": "docker compose -f devops/docker-compose.full.yml logs -f",
    "docker:full:ps": "docker compose -f devops/docker-compose.full.yml ps",
    "db:migrate": "node scripts/migrate-all-databases.js",
    "db:seed": "node scripts/migrate-all-databases.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0"
  }
}
